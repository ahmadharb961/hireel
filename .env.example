# Copy this file to `.env` and fill in the values. Never commit `.env`.
# On Hostinger, enter the same names and values as the app's environment variables.

# --- Database (Neon PostgreSQL) ---
# Neon dashboard → your project → Connect → copy the connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Your site address (no trailing slash) ---
APP_URL="https://yourdomain.com"
BETTER_AUTH_URL="https://yourdomain.com"

# --- Login security ---
# A long random secret. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- Email (Hostinger mailbox) ---
# hPanel → Emails → create no-reply@yourdomain.com. Host and port below are Hostinger's.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="no-reply@yourdomain.com"
SMTP_PASS=""
MAIL_FROM="Hireel <no-reply@yourdomain.com>"

# --- Video (Cloudflare Stream) ---
# Cloudflare dashboard: Account ID is on the right side of the overview page.
CLOUDFLARE_ACCOUNT_ID=""
# My Profile → API Tokens → Create Token → permission "Stream: Edit".
CLOUDFLARE_STREAM_API_TOKEN=""
# The signing key, webhook and customer code are created automatically on deploy.
# Only set these to override what the app set up for itself:
# CLOUDFLARE_STREAM_CUSTOMER_CODE=""
# CLOUDFLARE_STREAM_SIGNING_KEY_ID=""
# CLOUDFLARE_STREAM_SIGNING_KEY_PEM=""
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=""

# --- Phone notifications ---
# Nothing to set: the signing keys are created automatically and kept in the database.
# Only set these to override them:
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# --- Daily cleanup job ---
# Any long random text. The Hostinger cron job sends it to prove it's allowed.
CRON_SECRET=""

# --- First Super Admin ---
# Sign up on the site with this email and confirm it, then set this and redeploy.
# ADMIN_EMAIL="you@example.com"

# --- Optional ---
# Sign-in attempts allowed per minute from one internet address (default 20).
# AUTH_SIGNIN_LIMIT="20"
