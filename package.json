{
  "name": "hireel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && tsx scripts/setup.ts && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "tsx scripts/setup.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:clear": "tsx scripts/demo-clear.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "stream:setup": "tsx scripts/stream-setup.ts",
    "icons": "tsx scripts/make-icons.ts",
    "build:local": "prisma generate && next build --webpack"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "dotenv": "^18.0.9",
    "hls.js": "^1.7.3",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
